App(
    appid="subghz_test",
    name="Sub-Ghz test",
    apptype=FlipperAppType.DEBUG,
    targets=["f7"],
    entry_point="subghz_test_app",
    requires=["gui"],
    stack_size=4 * 1024,
    fap_icon="subghz_test_10px.png",
    fap_category="Debug",
    # SubGHz library is no longer in the firmware; carry a private copy.
    fap_private_libs=[
        Lib(name="subghz", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
    fap_icon_assets="images",
    fap_version="0.1",
)
