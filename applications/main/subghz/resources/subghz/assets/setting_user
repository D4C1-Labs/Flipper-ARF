# ---------------------------------------------------------------------------
# [ARF] "Pro" RX-sensitivity presets. Identical to the built-in AM650 / FM476
# but with the CC1101 FIFOTHR ADC_RETENTION bit set (0x03 = 0x47 instead of the
# power-on 0x07). Per TI's CC1101 datasheet (FIFOTHR, DN010) ADC_RETENTION=1
# improves RX sensitivity for RX filter bandwidths <= 325 kHz at low data rates
# (a real, ~1-3 dB gain), with only a small increase in RX current. TX power is
# UNCHANGED (PA table still 0xC0 = chip max; firmware cannot exceed it).
#
# The originals (AM650/FM476) are left untouched — use these Pro variants when
# you want the extra receive sensitivity for weak/distant signals.
# ---------------------------------------------------------------------------

# AM650 + ADC_RETENTION (OOK, 650 kHz BW). NOTE: 650 kHz is > 325 kHz so the
# ADC_RETENTION gain is smaller here than on the narrower presets; kept for
# parity with the built-in AM650.
Custom_preset_name: AM650_Pro
Custom_preset_module: CC1101
Custom_preset_data: 02 0D 03 47 08 32 0B 06 10 17 11 32 12 30 13 00 14 00 18 18 19 18 1B 07 1C 00 1D 91 20 FB 21 B6 22 11 00 00 00 C0 00 00 00 00 00 00

# FM476 + ADC_RETENTION (2-FSK, 270 kHz BW). 270 kHz <= 325 kHz, so this one
# gets the full ADC_RETENTION sensitivity benefit.
Custom_preset_name: FM476_Pro
Custom_preset_module: CC1101
Custom_preset_data: 02 0D 03 47 0B 06 08 32 07 04 14 00 13 02 12 04 11 83 10 67 15 47 18 18 19 16 1D 91 1C 00 1B 07 20 FB 22 10 21 56 00 00 C0 00 00 00 00 00 00 00

