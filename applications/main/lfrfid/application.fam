App(
    appid="lfrfid",
    name="125 kHz RFID",
    apptype=FlipperAppType.MENUEXTERNAL,
    targets=["f7"],
    entry_point="lfrfid_app",
    icon="A_125khz_14",
    stack_size=2 * 1024,
    order=20,
    resources="resources",
    # LF RFID library is no longer in the firmware; carry a private copy.
    sources=["*.c*", "!lfrfid_cli.c", "!lib"],
    fap_libs=["assets"],
    fap_private_libs=[
        Lib(name="lfrfid", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
    fap_icon="icon.png",
    fap_category="RFID",
)

App(
    appid="cli_rfid",
    targets=["f7"],
    apptype=FlipperAppType.PLUGIN,
    entry_point="cli_rfid_ep",
    requires=["cli"],
    sources=["lfrfid_cli.c"],
    # LF RFID library is no longer in the firmware; carry a private copy.
    fap_private_libs=[
        Lib(name="lfrfid", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
)
