App(
    appid="main_apps",
    name="Basic applications for main menu",
    apptype=FlipperAppType.METAPACKAGE,
    provides=[
        "gpio",
        "lfrfid",
        # NFC is now a self-contained external app carrying its own private copy
        # of lib/nfc (the NFC library is no longer linked into the firmware).
        "nfc",
        "subghz",
        "subghz_remote",
        "subghz_bruteforcer",
        "infrared",
        "archive",
        "main_apps_on_start",
    ],
)

App(
    appid="main_apps_on_start",
    name="On start hooks",
    apptype=FlipperAppType.METAPACKAGE,
    provides=[
        "cli",
    ],
)
