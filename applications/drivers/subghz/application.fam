App(
    appid="radio_device_cc1101_ext",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="subghz_device_cc1101_ext_ep",
    requires=["subghz"],
    # [ARF_PORT 2026-10-26] sources= must be explicit now that si4463_ext/ shares
    # this directory: without it the default glob would also pull the Si4463 files
    # into this plugin and collide with the si4463 plugin below.
    sources=["cc1101_ext/*.c*"],
    sdk_headers=["cc1101_ext/cc1101_ext_interconnect.h"],
    fap_libs=["hwdrivers"],
)

# [ARF_PORT 2026-10-26] Second external radio driver (Si4463), ported from
# doctor-firmware. Registered as a radio plugin exactly like cc1101_ext.
App(
    appid="radio_device_si4463_ext",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="subghz_device_si4463_ext_ep",
    requires=["subghz"],
    sources=["si4463_ext/*.c*"],
    sdk_headers=["si4463_ext/si4463_ext_interconnect.h"],
)
