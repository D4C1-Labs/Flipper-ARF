App(
    appid="nfc_magic",
    name="NFC Magic",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="nfc_magic_app",
    requires=[
        "storage",
        "gui",
    ],
    stack_size=4 * 1024,
    fap_description="Application for writing to NFC tags with modifiable sector 0",
    fap_version="1.11",
    fap_icon="assets/Nfc_10px.png",
    fap_category="NFC",
    fap_icon_assets="assets",
    # NFC library is no longer in the firmware; carry a private copy (full lib —
    # nfc_magic uses the generic nfc_poller framework, so it needs the mf_classic
    # poller/listener that the poller/listener defs reference).
    #
    # nfc_magic vendors its own MIFARE Classic gen2 poller under
    # magic/protocols/gen2, which duplicated crypto1_* and mf_classic_process_error.
    # We drop the vendored duplicates instead: gen2/crypto1.c is excluded from the
    # app sources below (the lib provides an identical crypto1 with the same
    # Crypto1 struct), and the duplicate mf_classic_process_error definition was
    # removed from gen2/gen2_poller_i.c (now taken from the lib).
    sources=["*.c*", "!lib", "!crypto1.c"],
    fap_libs=["mbedtls", "bit_lib"],
    fap_private_libs=[
        Lib(name="nfc", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
)
