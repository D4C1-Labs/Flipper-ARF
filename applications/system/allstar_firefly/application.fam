App(
    appid="allstar_firefly",
    name="Allstar Firefly",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="allstar_firefly_app",
    stack_size=4 * 1024,
    fap_category="Sub-GHz",
    # SubGHz library is no longer in the firmware; carry a private copy.
    fap_private_libs=[
        Lib(name="subghz", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
    fap_description="Allstar Firefly 318ALD31K gate remote - 9-bit trinary OOK decoder/emulator",
    fap_author="jlaughter",
    fap_version="0.1",
    fap_icon="icon.png",
)
