App(
    appid="pandora_arm",
    name="Pandora ARM",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="pandora_arm_app",
    sources=["*.c*", "!lib", "!tests", "!hosttest"],
    requires=["gui", "dialogs", "storage"],
    stack_size=8 * 1024,
    fap_private_libs=[
        Lib(
            # Thumb-2 (Cortex-M3) interpreter as a private lib with -O2: the
            # per-instruction decode/execute loop is the hot path.
            name="thumbcore",
            cflags=["-O2"],
        ),
    ],
    fap_category="Sub-GHz",
    fap_icon="icon.png",
    fap_author="user",
    fap_version="0.1",
    fap_description="Emulates the real Pandora D-605 keyfob firmware (EFM32 Cortex-M3). Loads the .hex/.bin from SD, shows the keyfob OLED, knock-code unlock, and uses the Flipper CC1101 for real RF RX/TX.",
)
