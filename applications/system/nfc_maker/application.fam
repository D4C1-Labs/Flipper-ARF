App(
    appid="nfc_maker",
    name="NFC Maker",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="nfc_maker",
    stack_size=2 * 1024,
    fap_icon="nfc_maker_10px.png",
    fap_category="NFC",
    # NFC library is no longer in the firmware; carry a private copy.
    fap_private_libs=[
        Lib(name="nfc", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
    fap_author="@Willy-JL",
    fap_weburl="https://github.com/Next-Flip/Momentum-Apps/tree/dev/nfc_maker",
    fap_version="2.1",
    fap_description="Create NFC files for BT MACs, Contacts, Links, Emails, Phones, Text and WiFis",
    fap_icon_assets="icons",
    fap_libs=["assets", "mbedtls", "bit_lib"],
)
