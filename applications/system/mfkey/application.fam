App(
    appid="mfkey",
    name="MFKey",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="mfkey_main",
    requires=[
        "gui",
        "storage",
    ],
    stack_size=8 * 1024,
    fap_icon="mfkey.png",
    fap_category="NFC",
    fap_author="@noproto",
    fap_icon_assets="images",
    fap_description="MIFARE Classic key recovery tool",
    fap_version="4.1",
    # NFC library is no longer in the firmware; carry a private copy. mfkey's own
    # crypto1 uses a distinct 'Crypto1State' struct and 'crypto1_get_lfsr' symbol,
    # so it does not collide with the private nfc lib's crypto1.
    fap_libs=["mbedtls", "bit_lib"],
    fap_private_libs=[
        Lib(name="nfc", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
)

App(
    appid="mfkey_init_plugin",
    apptype=FlipperAppType.PLUGIN,
    entry_point="init_plugin_ep",
    requires=["mfkey"],
    sources=["init_plugin.c"],
    fal_embedded=True,
)
