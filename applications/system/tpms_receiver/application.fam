App(
    appid="tpms",
    name="TPMS Reader",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="tpms_app",
    requires=["gui"],
    stack_size=4 * 1024,
    order=50,
    fap_icon="tpms_10px.png",
    fap_version="1.0",
    fap_author="@wosk",
    fap_weburl="https://github.com/wosk/flipperzero-tpms",
    fap_description="Use SubGHz and RFID to read or activate TPMS sensors",
    fap_category="Sub-GHz",
    # SubGHz library is no longer in the firmware; carry a private copy.
    fap_private_libs=[
        Lib(name="subghz", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
    fap_icon_assets="images",
)
