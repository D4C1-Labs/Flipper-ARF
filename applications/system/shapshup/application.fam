App(
    appid="shapshup",
    name="ShapShup",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="shapshup_app",
    cdefines=["APP_SHAPSHUP"],
    requires=["gui", "dialogs"],
    stack_size=2 * 1024,
    order=13,
    fap_icon="images/shapshup_10px.png",
    fap_category="Sub-GHz",
    # SubGHz library is no longer in the firmware; carry a private copy.
    fap_private_libs=[
        Lib(name="subghz", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
    fap_icon_assets="images",
)
