App(
    appid="subghz_raw_edit",
    name="Sub-GHz RAW Edit",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="subghz_raw_edit_app",
    stack_size=2 * 1024,
    fap_category="Sub-GHz",
    # SubGHz library is no longer in the firmware; carry a private copy.
    fap_private_libs=[
        Lib(name="subghz", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
    fap_author="Lechnio",
    fap_weburl="https://github.com/Lechnio/SubGHz-RAW-Edit",
    fap_version="1.5",
    fap_icon="icon.png",
    fap_icon_assets="icons",
    fap_description="Open a recorded RAW .sub capture, find the real signal in a sea of noice, pick start/end with the arrows and save just the trimmed burst.",
)
