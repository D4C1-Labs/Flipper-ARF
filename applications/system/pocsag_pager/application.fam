App(
    appid="pocsag_pager",
    name="POCSAG Pager",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="pocsag_pager_app",
    requires=["gui"],
    stack_size=4 * 1024,
    order=50,
    fap_icon="pocsag_pager_10px.png",
    fap_category="Sub-GHz",
    # SubGHz library is no longer in the firmware; carry a private copy.
    fap_private_libs=[
        Lib(name="subghz", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
    fap_icon_assets="images",
    fap_author="@xMasterX & @Shmuma",
    fap_version="1.4",
    fap_description="App can capture POCSAG 1200 messages on CC1101 supported frequencies.",
)
