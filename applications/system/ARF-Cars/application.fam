        "protocols/bin_raw.c",
        "protocols/keeloq_common.c",
        "protocols/aut64.c",
        "protocols/hitag2_seed.c",
        "protocols/hitag2_key_db.c",
        "protocols/vag.c",
        "protocols/ford_v0.c",
        "protocols/ford_v1.c",
        "protocols/ford_v2.c",
        "protocols/ford_v3.c",
        "protocols/psa.c",
        "protocols/fiat_v0.c",
        "protocols/fiat_v1.c",
        "protocols/fiat_v2.c",
        "protocols/renault_v0.c",
        "protocols/renault_v1.c",
        "protocols/subaru.c",
        "protocols/kia_v0.c",
        "protocols/kia_v1.c",
