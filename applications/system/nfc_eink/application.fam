App(
    appid="nfc_eink",
    name="NFC Eink Tags",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="nfc_eink",
    stack_size=5 * 1024,
    order=30,
    sources=["*.c*"],
    fap_icon="icon.png",
    fap_icon_assets="assets",
    fap_description="Application for emulation and writing to NFC Eink tags",
    fap_version="1.0",
    fap_category="NFC",
    # NFC library is no longer in the firmware; carry a private copy.
    fap_private_libs=[
        Lib(name="nfc", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
    fap_libs=["mbedtls", "bit_lib"],
)
