# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="subghz_scheduler",  # Must be unique
    name="Sub-GHz Scheduler",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="scheduler_app",
    stack_size=5 * 1024,
    fap_category="Sub-GHz",
    # SubGHz library is no longer in the firmware; carry a private copy.
    fap_private_libs=[
        Lib(name="subghz", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
    fap_version="2.2",
    fap_icon="icons/icon.png",  # 10x10 1-bit PNG
    fap_icon_assets="icons",  # Image assets to compile for this application
    fap_author="Patrick Edwards",
    fap_weburl="https://github.com/shalebridge/flipper-subghz-scheduler",
    fap_description="Send a Sub-GHz signal repeatedly at a given interval.",
)
