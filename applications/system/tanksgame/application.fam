App(
    appid="tanks",
    name="Tanks",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="tanks_game_app",
    cdefines=["APP_TANKS_GAME"],
    requires=["gui", "subghz"],
    stack_size=4 * 1024,
    order=730,
    fap_icon="tanksIcon.png",
    fap_category="Games",
    # SubGHz library is no longer in the firmware; carry a private copy.
    fap_private_libs=[
        Lib(name="subghz", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
    fap_icon_assets="images",
)
