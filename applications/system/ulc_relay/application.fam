App(
    appid="ulc_relay",
    name="UL-C Relay",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="ulc_relay_app",
    requires=["gui", "subghz"],
    stack_size=2 * 1024,
    fap_version=(1, 0),
    fap_icon="ulcrelay.png",
    fap_icon_assets="images",
    fap_icon_assets_symbol="ulcrelay",
    fap_category="NFC",
    # SubGHz library is no longer in the firmware; carry a private copy.
    fap_private_libs=[
        Lib(name="subghz", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
    fap_author="noproto",
    fap_description="Relay Ultralight C authentication",
    fap_weburl="https://github.com/noproto",
)
