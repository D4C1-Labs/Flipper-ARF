App(
    appid="radio_scanner",
    name="Radio Scanner",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="radio_scanner_app",
    requires=["gui", "subghz"],
    stack_size=2 * 1024,
    fap_category="Sub-GHz",
    # SubGHz library is no longer in the firmware; carry a private copy.
    fap_private_libs=[
        Lib(name="subghz", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
    fap_version="0.2",
    fap_icon_assets="assets",
    fap_author="@RocketGod-git",
    fap_description="Scanner for Flipper",
    fap_icon="icons/radio_scanner.png",
    fap_weburl="https://github.com/RocketGod-Git/Flipper-Zero-Radio-Scanner",
)
