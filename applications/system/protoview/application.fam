App(
    appid="protoview",
    name="ProtoView",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="protoview_app_entry",
    requires=["gui"],
    stack_size=8*1024,
    order=50,
    fap_icon="appicon.png",
    fap_category="Sub-GHz",
    # SubGHz library is no longer in the firmware; carry a private copy.
    fap_private_libs=[
        Lib(name="subghz", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
    fap_author="@antirez & (fixes by @xMasterX)",
    fap_version="1.3",
    fap_description="Digital signal detection, visualization, editing and reply tool",
)
