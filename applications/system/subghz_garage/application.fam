App(
    appid="subghz_garage",
    name="Garage/Gate/Other",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="subghz_app",
    requires=[
        "gui",
        "dialogs",
    ],
    # 3KB (inherited from the Automotive fork, which never exercises the
    # PluginManager/ELF loader since it's compiled directly into firmware)
    # was marginal here: this app loads external .fal plugins at runtime
    # (external CC1101 device, protocol group plugins), and that machinery
    # has deeper/more stack-hungry call chains than a normal statically-
    # linked app ever hits. General heap has 130KB+ free at idle, so this
    # is cheap - raised to give real headroom against a stack overflow.
    stack_size=6 * 1024,
    resources="resources",
    # cdefines ajustados para Flipper-ARF. Cada SUBGHZ_GARAGE_HAS_* activa
    # el uso directo de una API de la lib/firmware; si se omite, el shim
    # helpers/*_compat.h usa un fallback. Verificado contra ARF:
    #   DEVICES_LAZY_INIT  -> OFF: ARF no tiene subghz_devices_init_internal_only()/
    #                         load_external(); el shim usa subghz_devices_init().
    #   CLI_VCP_LOCK       -> OFF: ARF no expone cli_vcp_session_lock(); ademas
    #                         subghz_cli.c esta excluido de esta app.
    #   MEMMGR_POOL_STATS  -> OFF: ARF declara pero no implementa memmgr_pool_*;
    #                         solo se usaba para logging de heap (fallback = 0).
    #   LIB_EXTENSIONS, CUSTOM_BTN, GENERIC_GLOBAL, BINRAW_TYPE, RECEIVER_ICONS,
    #   FONT_BATTERY_PERCENT, NAME_GEN_DATETIME, ITEM_LOCK, TX_ALLOWED_CHECK
    #                      -> ON: todas verificadas presentes en ARF.
    # GENERIC_DATA2_SEED no va aqui (ningun source del app principal lo usa);
    # se setea en los App() de grupo/TX de abajo que compilan Jarolift, Nice
    # FlorS, FAAC SLH, Alutech AT-4N, Beninca ARC, Came Atomo, KingGates y
    # Somfy Keytis.
    cdefines=[
        "SUBGHZ_GARAGE_HAS_LIB_EXTENSIONS=1",
        "SUBGHZ_GARAGE_HAS_CUSTOM_BTN=1",
        "SUBGHZ_GARAGE_HAS_GENERIC_GLOBAL=1",
        "SUBGHZ_GARAGE_HAS_BINRAW_TYPE=1",
        "SUBGHZ_GARAGE_HAS_RECEIVER_ICONS=1",
        "SUBGHZ_GARAGE_HAS_FONT_BATTERY_PERCENT=1",
        "SUBGHZ_GARAGE_HAS_NAME_GEN_DATETIME=1",
        "SUBGHZ_GARAGE_HAS_ITEM_LOCK=1",
        "SUBGHZ_GARAGE_HAS_TX_ALLOWED_CHECK=1",
    ],
    sources=[
        "*.c*",
        "!subghz_cli.c",
        "!subghz_dangerous_freq.c",
        "!subghz_chat.c",
        # subghz_scene_start.c reescrito para ARF (submenu propio Read/Read RAW/
        # Saved, estilo Sub-GHz principal) -> ahora SI se compila.
        # El grid de inicio de FoxFW (fox_theme) y Protocol List/Groups siguen
        # fuera: ARF no tiene fox_theme y esta app entra directo por argumento.
        "!subghz_view_start_grid.c",
        "!subghz_scene_protocol_list.c",
        "!subghz_view_protocol_groups.c",
        "!protocols",
        "protocols/protocol_groups.c",
        # Automotive-only KeeLoq manufacturer-key bruteforce/decrypt toolchain
        # and PSA Decrypt - not needed for garage/gate use. Source still on
        # disk (not deletable from here) but excluded from compilation; a
        # copy is staged in D:\_to_delete for reference.
        "!subghz_scene_psa_decrypt.c",
        "!subghz_scene_keeloq_bf2.c",
        "!subghz_scene_keeloq_decrypt.c",
        "!subghz_scene_kl_bf_cleanup.c",
        "!subghz_scene_keeloq_keys.c",
        "!subghz_scene_keeloq_key_edit.c",
        "!subghz_keeloq_keys.c",
        "!subghz_psa_decrypt.c",
        "!subghz_keeloq_decrypt.c",
        # "Add Manually" removed entirely - manual key/serial/counter/seed
        # entry across ~50 protocol variants wasn't worth its own code size
        # in a stripped-down garage/gate tool. Source still on disk (not
        # deletable from here) but excluded from compilation, same as the
        # Automotive-only files above.
        "!subghz_scene_set_type.c",
        "!subghz_scene_set_key.c",
        "!subghz_scene_set_serial.c",
        "!subghz_scene_set_seed.c",
        "!subghz_scene_set_counter.c",
        "!subghz_scene_set_button.c",
        # Also dead: nothing ever navigated to this scene even before Add
        # Manually was removed (no scene_manager_next_scene call anywhere
        # targeted it).
        "!subghz_scene_custom_freq.c",
        "!subghz_gen_info.c",
        "!subghz_txrx_create_protocol_key.c",
        # Radio Settings scene removal (shared with Automotive via the Mode
        # Picker) left this empty stray file behind - can't be deleted from
        # here, excluded so it's never compiled either way.
        "!subghz_scene_radio_settings.c.bak",
        # "Modulations" screen removed from the Start page - manual per-
        # preset enable/disable was redundant with Protocol Group selection
        # once decoders were confirmed not to be modulation-gated. Its
        # ADD_SCENE entry is gone from scenes/subghz_scene_config.h, so this
        # file no longer compiles (references the now-undefined
        # SubGhzSceneModulationList) - can't be deleted from here, excluded.
        # Please delete this file, along with two now-superseded settings
        # resources - resources/subghz/assets/setting_garage (replaced by
        # setting_garage_full) and resources/subghz/assets/setting_garage_boot
        # (a boot/full settings split was tried and reverted - see the
        # comment in helpers/subghz_txrx.c's subghz_txrx_alloc() - so this
        # one was never actually shipped in a release, just leftover from
        # mid-session) - next time you're in here.
        "!subghz_scene_modulation_list.c",
    ],
    fap_libs=["assets", "hwdrivers"],
    fap_icon="icon.png",
    fap_category="Sub-GHz",
    fap_description="Sub-GHz - garage, gate, and other non-automotive protocols. Opened from the main Sub-GHz app's \"Garage / Gate\" entry.",
    fap_version="1.0",
)

# The 40 non-automotive protocols (plus Read RAW's raw/bin_raw, duplicated
# in every group) are split into 11 plugins instead of one. Flipper maps an
# external app's whole binary into RAM to run it, and one combined plugin
# couldn't be resident in RAM1 alongside the main .fap ("Not enough memory
# to load section data"). Groups are organized by manufacturer/region/
# device-type, capped at 4 protocols each - see
# subghz_garage_protocol_group_names in protocol_groups.c for what's in
# each one. Only one group is ever loaded at a time - see
# subghz_txrx_ensure_protocol_group in helpers/subghz_txrx.c.
App(
    appid="grp_g1",
    apptype=FlipperAppType.PLUGIN,
    entry_point="subghz_garage_protocol_plugin_g1_ep",
    requires=["subghz_garage"],
    cdefines=["SUBGHZ_GARAGE_RX_ONLY=1", "SUBGHZ_GARAGE_HAS_GENERIC_GLOBAL=1", "SUBGHZ_GARAGE_HAS_BINRAW_TYPE=1"],
    sources=[
        "protocols/plugins/subghz_garage_protocol_plugin_g1.c",
        "protocols/protocols_common.c",
        "protocols/raw.c",
        "protocols/bin_raw.c",
        "protocols/smc5326.c",
        "protocols/holtek.c",
        "protocols/holtek_ht12x.c",
        "protocols/princeton.c",
    ],
    fal_embedded=True,
)

