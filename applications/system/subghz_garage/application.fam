# Each of Group 1's protocols (plus RAW/BinRAW, shared by every group) gets
# its own tiny single-protocol TX plugin carrying just that one encoder -
# the RX group plugin is compiled RX_ONLY (no encoders at all) to keep it
# small, so replaying a captured/saved signal with "Send" loads one of
# these instead, on demand, rather than needing the whole group's encoders
# resident just for RX - mirroring ProtoPirate's RX/TX plugin split. See
# subghz_txrx_ensure_tx_protocol_plugin() / subghz_garage_tx_protocol_for_name()
# in helpers/subghz_txrx.c and protocols/protocol_groups.c.
App(
    appid="tx_alutech_at_4n",
    apptype=FlipperAppType.PLUGIN,
    entry_point="subghz_garage_tx_alutech_at_4n_plugin_ep",
    requires=["subghz_garage"],
    cdefines=["SUBGHZ_GARAGE_HAS_GENERIC_GLOBAL=1", "SUBGHZ_GARAGE_HAS_BINRAW_TYPE=1", "SUBGHZ_GARAGE_HAS_GENERIC_DATA2_SEED=1"],
    sources=[
        "protocols/plugins/subghz_garage_tx_alutech_at_4n_plugin.c",
        "protocols/protocols_common.c",
        "protocols/alutech_at_4n.c",
    ],
    fal_embedded=True,
)

