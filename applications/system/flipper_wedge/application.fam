App(
    appid="flipper_wedge",
    name="Flipper Wedge",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flipper_wedge_app",
    cdefines=["APP_FLIPPER_WEDGE"],
    requires=[
        "gui",
        "storage",
        "bt",
    ],
    stack_size=4 * 1024,
    order=10,
    # NFC and LF RFID libraries are no longer in the firmware; carry private
    # copies of both (this app reads RFID and NFC tags).
    fap_libs=["ble_profile", "mbedtls", "bit_lib"],
    fap_private_libs=[
        Lib(name="nfc", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
        Lib(name="lfrfid", fap_include_paths=[".", ".."], cflags=["-Wno-error"]),
    ],
    fap_icon="icons/flipper_wedge_10px.png",
    fap_icon_assets="icons",
    fap_category="Tools",
    fap_version="1.1",
    fap_description="Read RFID/NFC tags and type their UIDs as HID keyboard input via USB or Bluetooth. Supports 5 scan modes and NDEF text records.",
    fap_author="Dangerous Things",
    fap_weburl="https://github.com/DangerousThings/flipper-wedge",
)
